<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sign in with Apple. Without this the AuthenticationServices request
	     fails immediately with AKAuthenticationError -7026. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- Push. Without this the device gets no APNs token, getAPNSToken()
	     returns null, and FirebaseMessaging.getToken() throws — which is why
	     no iOS device had ever registered. "development" is what a debug
	     build needs; Xcode rewrites it to "production" when archiving for
	     TestFlight and the App Store. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
